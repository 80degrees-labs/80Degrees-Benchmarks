# Default deny: the live study contains credentials-adjacent logs and local paths.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/public/
!/tooling/
!/examples/
!/tests/
!/docs/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.env*
**/*auth*.json
**/*secret*
**/*.sqlite*
**/*.log
**/*.pdf
public/studies/*/reports/
**/node_modules/
**/.venv/
